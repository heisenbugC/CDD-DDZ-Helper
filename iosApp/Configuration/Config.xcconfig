TEAM_ID=

PRODUCT_NAME=cdd-ddz-helper
PRODUCT_BUNDLE_IDENTIFIER=com.desmond.cddddz

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Skip unnecessary Kotlin framework Gradle build phase since iosApp is pure SwiftUI
OVERRIDE_KOTLIN_BUILD_IDE_SUPPORTED = YES

// Link CoreML and Metal required by TensorFlowLiteCCoreML / Metal delegates
OTHER_LDFLAGS = $(inherited) -framework CoreML -framework Metal

